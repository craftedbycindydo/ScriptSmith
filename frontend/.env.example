# Zitadel OIDC. Leave unset to keep the password-only login pages
# (the Google button renders only when both are present).
VITE_ZITADEL_ISSUER=https://auth.scriptingsmith.com

# Production SPA client - HTTPS redirect URIs only.
VITE_ZITADEL_CLIENT_ID=384702983641766612

# Local development uses a separate client with devMode enabled, so that
# http://localhost redirects are accepted without weakening the production one:
# VITE_ZITADEL_CLIENT_ID=384706310463037124
