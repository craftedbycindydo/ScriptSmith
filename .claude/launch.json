{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8082"],
      "port": 8082
    },
    {
      "name": "backend-e2e",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && DATABASE_URL=sqlite:///./e2e_test.db venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8082"],
      "port": 8082
    },
    {
      "name": "python-executor",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd services/python-executor && ../../backend/venv/bin/python main.py"],
      "port": 8001
    }
  ]
}
