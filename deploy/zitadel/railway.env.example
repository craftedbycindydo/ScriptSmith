# Zitadel service variables (Railway - Scripting smith / production)
# Copy values in via `railway variables --service Zitadel --set K=V`.
# Nothing secret is committed here.

# --- identity of the instance -------------------------------------------------
# Baked in at init. Changing it later breaks cookies and redirects.
ZITADEL_EXTERNALDOMAIN=auth.scriptingsmith.com
ZITADEL_EXTERNALPORT=443
ZITADEL_EXTERNALSECURE=true

# Railway terminates TLS; Zitadel must not try to.
ZITADEL_TLS_ENABLED=false

# Railway injects PORT; Zitadel listens here.
ZITADEL_PORT=8080

# 32 chars exactly. openssl rand -base64 24 | head -c 32
ZITADEL_MASTERKEY=

# --- database -----------------------------------------------------------------
# Reuses the existing Postgres service over the private network.
# Zitadel creates its own `zitadel` database + user using the admin credentials.
ZITADEL_DATABASE_POSTGRES_HOST=postgres-ujjc.railway.internal
ZITADEL_DATABASE_POSTGRES_PORT=5432
ZITADEL_DATABASE_POSTGRES_DATABASE=zitadel
ZITADEL_DATABASE_POSTGRES_USER_USERNAME=zitadel
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=
ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE=disable
ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME=postgres
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=
ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE=disable

# --- THE migration-critical setting -------------------------------------------
# Enables verification of the argon2id hashes produced by the current app
# (PasswordHasher time_cost=3 memory_cost=65536 parallelism=1, security.py:15-21).
# Without this every imported user is locked out.
ZITADEL_SYSTEMDEFAULTS_PASSWORDHASHER_VERIFIERS=argon2,bcrypt

# --- first instance -----------------------------------------------------------
ZITADEL_FIRSTINSTANCE_ORG_NAME=ScriptingSmith
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORDCHANGEREQUIRED=true

# Machine user + PAT so the import script can drive the API.
# PAT_EXPIRATIONDATE is required or the PAT file is silently not written.
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME=migration-sa
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME=Migration Service Account
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_SCOPES=openid urn:zitadel:iam:org:project:id:zitadel:aud
ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE=2027-01-01T00:00:00Z
